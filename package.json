{
  "name": "@quantavoxel/latlng-extract",
  "version": "1.0.1",
  "description": "Extract latitude and longitude coordinates from Google Maps short links (maps.app.goo.gl)",
  "keywords": [
    "google-maps",
    "coordinates",
    "latitude",
    "longitude",
    "latlng",
    "gps",
    "maps",
    "short-link",
    "goo.gl",
    "geolocation",
    "extract"
  ],
  "homepage": "https://github.com/QuantaVoxel/latlng-extract#readme",
  "bugs": {
    "url": "https://github.com/QuantaVoxel/latlng-extract/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/QuantaVoxel/latlng-extract.git"
  },
  "license": "MIT",
  "author": "Quantavoxel <developer@quantavoxel.digital>",
  "type": "module",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "require": "./dist/index.cjs",
      "types": "./dist/index.d.ts"
    }
  },
  "main": "dist/index.cjs",
  "types": "dist/index.d.ts",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc",
    "dev": "tsx src/tes.ts",
    "prepublishOnly": "npm run build",
    "lint": "tsc --noEmit"
  },
  "dependencies": {
    "axios": "^1.7.0"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "tsx": "^4.22.4",
    "typescript": "^5.4.0"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "module": "dist/index.js",
  "allowScripts": {
    "esbuild@0.28.0": true
  }
}
